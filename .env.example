# ===== Django / Backend =====
# مفتاح التشفير — يولّد مرة واحدة فقط ويُحفظ في سرّ المنصة (لا تُضمّنه في الكود).
# توليد مفتاح آمن:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# فصّل التصحيح: 'True' في التطوير فقط، و 'False' في الإنتاج.
DJANGO_DEBUG=False

# قائمة المضيفات المسموحة مفصولة بفواصل.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.onrender.com

# قائمة أصول CORS المسموحة مفصولة بفواصل (عنوان تطبيق الواجهة الأمامية).
DJANGO_CORS_ALLOWED_ORIGINS=https://your-app.netlify.app

# ===== قاعدة البيانات (Neon / Postgres) =====
# اقسّم رابط اتصال Neon إلى المتغيرات التالية:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
POSTGRES_DB=your-database-name
POSTGRES_USER=your-database-user
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=ep-xxxx-yyyy.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
# 'require' لـ Neon، و 'prefer' (افتراضي) للتطوير المحلي.
POSTGRES_SSL_MODE=require

# ===== Frontend (Vite / Netlify) =====
# عنوان API الأساسي الذي يصل إليه تطبيق الواجهة الأمامية.
VITE_API_BASE_URL=https://your-api.onrender.com/api/v1
